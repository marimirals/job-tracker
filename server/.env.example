PORT=8080
DATABASE_URL=postgres://jobtracker:jobtracker@localhost:5432/jobtracker?sslmode=disable
CORS_ORIGINS=http://localhost:5173

# Основной провайдер: OpenRouter (подходит любой OpenAI-совместимый)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Запасной провайдер: GigaChat
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_CA_CERT=certs/russian_trusted_root_ca.pem

# hh.ru просит указывать название приложения и контакт
HH_USER_AGENT=JobTracker/0.1 (your@email.com)